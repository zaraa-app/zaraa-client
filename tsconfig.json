{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "es2015",
    "lib": ["dom", "ES2024"],
    "jsx": "react-native",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["react", "react-native"],
    "downlevelIteration": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "nativewind-env.d.ts", "declarations.d.ts", "prettier.config.js"]
}
